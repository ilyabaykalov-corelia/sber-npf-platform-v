<bpmn2:task id="Activity_kid_create" name="Зафиксировать КИД ОПС" sbt:apiSource="manual" sbt:buildingBlockId="" sbt:methodName="POST" sbt:outputMapping="expression" sbt:payloadType="map" sbt:retryPolicyModelDescription="" sbt:retryPolicyModelId="" sbt:sbtType="com.sbt.bpms.modeler.plugin.marker.GraphQLTask" sbt:sourceFile="" sbt:timeout="" sbt:url="${env.ds.app}/model/graphql">
      <bpmn2:extensionElements>
        <sbt:httpHeaderList>
          <sbt:httpHeader sbt:id="HTTPHeader_kid_create_content_type" sbt:required="true" xsi:type="sbt:HTTPHeader">
