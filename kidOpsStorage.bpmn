        <sbt:graphQLRequestBody>
          <sbt:query sbt:required="true" sbt:type="literal"><![CDATA[mutation createKidOps($document: _CreateDocumentInput!, $input: _CreateKidOpsInput!, $file: _CreateAttachmentInput!, $command: _CreateDocumentCommandInput!) { packet { createDocument(input: $document) { id documentId documentType { id name } } createKidOps(input: $input) { id status } createAttachment(input: $file) { id } createDocumentCommand(input: $command) { id } } }]]></sbt:query>
          <sbt:operationName>createKidOps</sbt:operationName>
          <sbt:variables><![CDATA[{ "document": { "documentId": ${documentId}, "documentType": "KID_OPS", "createdBy": ${createdBy}, "createdAt": ${createdAt} }, "input": { "document": "ref:createDocument", "contractNumber": ${contractNumber}, "contractDate": ${contractDate}, "signingYear": ${signingYear}, "lastName": ${lastName}, "firstName": ${firstName}, "middleName": ${middleName}, "snils": ${snils}, "status": "CREATED" }, "file": { "attachmentId": ${initial_attachmentId}, "logicalAttachmentId": ${initial_attachmentId}, "documentId": ${documentId}, "fileName": ${initial_fileName}, "contentType": ${initial_contentType}, "size": ${initial_size}, "storageReference": ${initial_storageReference}, "version": 1, "current": true, "uploadedAt": ${initial_uploadedAt} }, "command": { "document": "ref:createDocument", "commandKey": ${creationKey}, "requestHash": ${creationHash}, "response": "{}" } }]]></sbt:variables>
        </sbt:graphQLRequestBody>
        <sbt:graphQLResponseMapping>
          <sbt:mappingItem sbt:expression="@RESULT.data.packet.createKidOps.id" sbt:id="Element_kid_map_id" sbt:variableName="id"/>
          <sbt:mappingItem sbt:expression="@RESULT.data.packet.createDocument.documentType.id" sbt:id="Element_kid_map_document_type" sbt:variableName="documentType"/>
        </sbt:graphQLResponseMapping>
      </bpmn2:extensionElements>
