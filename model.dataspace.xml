<model model-name="sber_npf_pds_contracts" version="1.1.0-SNAPSHOT">
  <enum name="PdsContractStatus">
    <value name="CREATED"/>
    <value name="IN_WORK"/>
    <value name="ON_APPROVAL"/>
    <value name="NEEDS_REVISION"/>
    <value name="APPROVED"/>
    <value name="REJECTED"/>
  </enum>
  <enum name="KidOpsStatus">
    <value name="CREATED"/>
    <value name="IN_WORK"/>
    <value name="STORED"/>
  </enum>
  <class name="DocumentType" is-dictionary="true">
    <property name="name" type="STRING" length="255"/>
  </class>
  <class name="DocumentProcessSettings" is-dictionary="true">
    <property name="documentType" type="DocumentType"/>
    <property name="processId" type="STRING" length="254"/>
    <property name="enabled" type="BOOLEAN"/>
  </class>
  <class name="Document" strategy="JOINED">
    <property name="versions" type="DocumentVersion" collection="set" mappedBy="document"/>
    <property name="commands" type="DocumentCommand" collection="set" mappedBy="document"/>
    <property name="kidOps" type="KidOps" mappedBy="document"/>
    <property name="pdsContract" type="PdsContract" mappedBy="document"/>
    <property name="documentId" type="STRING" length="36" unique="true"/>
    <property name="documentType" type="DocumentType"/>
    <property name="createdBy" type="STRING" length="254"/>
    <property name="createdAt" type="LOCALDATETIME" length="3"/>
    <property name="version" type="INTEGER"/>
    <property name="changeToken" type="STRING" length="36"/>
  </class>
  <class name="PdsContract" strategy="JOINED">
    <property name="document" type="Document" parent="true" unique="true"/>
    <property name="contractDate" type="LOCALDATE"/>
    <property name="contractNumber" type="STRING" length="64"/>
    <property name="snils" type="STRING" length="64"/>
    <property name="status" type="PdsContractStatus"/>
  </class>
  <class name="KidOps" strategy="JOINED">
    <property name="document" type="Document" parent="true" unique="true"/>
    <property name="contractNumber" type="STRING" length="64"/>
    <property name="contractDate" type="LOCALDATE"/>
    <property name="signingYear" type="INTEGER"/>
    <property name="lastName" type="STRING" length="40"/>
    <property name="firstName" type="STRING" length="255"/>
    <property name="middleName" type="STRING" length="256"/>
    <property name="snils" type="STRING" length="14"/>
    <property name="status" type="KidOpsStatus"/>
  </class>
  <!-- Application snapshots shared by all document types; not DataSpace historization. -->
  <class name="DocumentVersion" strategy="JOINED">
    <property name="document" type="Document" parent="true"/>
    <property name="documentId" type="STRING" length="36" index="true"/>
    <property name="version" type="INTEGER"/>
    <property name="schemaVersion" type="INTEGER"/>
    <property name="attributes" type="Text"/>
    <property name="attachments" type="Text"/>
    <property name="createdBy" type="STRING" length="254"/>
    <property name="createdAt" type="LOCALDATETIME" length="3"/>
    <property name="closedAt" type="LOCALDATETIME" length="3"/>
    <index unique="true"><property name="document"/><property name="version"/></index>
  </class>
  <class name="DocumentCommand" strategy="JOINED">
    <property name="document" type="Document" parent="true"/>
    <property name="commandKey" type="STRING" length="64" unique="true"/>
    <property name="requestHash" type="STRING" length="64"/>
    <property name="response" type="Text"/>
    <property name="history" type="Text"/>
  </class>
  <class name="Attachment" strategy="JOINED">
    <property name="attachmentId" type="STRING" length="36"/>
    <property name="logicalAttachmentId" type="STRING" length="36"/>
    <property name="documentId" type="STRING" length="36"/>
    <property name="fileName" type="STRING" length="1024"/>
    <property name="contentType" type="STRING" length="254"/>
    <property name="size" type="LONG"/>
    <property name="storageReference" type="STRING" length="2048"/>
    <property name="version" type="INTEGER"/>
    <property name="current" type="BOOLEAN"/>
    <property name="uploadedAt" type="LOCALDATETIME" length="3"/>
  </class>
</model>
