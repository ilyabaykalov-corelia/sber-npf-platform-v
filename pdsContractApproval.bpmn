<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:sbt="http://com.sbt/bpms/modeler" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" exporter="Platform V Flow Designer" exporterVersion="0.0.2-796" id="Definitions_pds_contract_approval" targetNamespace="http://com.sbt/bpms/modeler">
  <bpmn2:itemDefinition id="Element_string" itemKind="Information" structureRef="java.lang.String"/>
  <bpmn2:process id="Process_pds_contract_approval" isExecutable="true" name="Согласование договора ПДС" sbt:AIAgentProcessMarker="false" sbt:contextVisible="false" sbt:enableStrictGatewaysBehavior="true" sbt:externalVersion="2" sbt:processOwner.roleCode="app_owner">
    <bpmn2:extensionElements>
      <sbt:processExtensions>
        <sbt:scopes>
          <sbt:userScopes>
            <sbt:scope>PdsContract:create</sbt:scope>
            <sbt:scope>PdsContract:read</sbt:scope>
            <sbt:scope>PdsContract:update</sbt:scope>
            <sbt:scope>PdsContract:approve</sbt:scope>
          </sbt:userScopes>
        </sbt:scopes>
      </sbt:processExtensions>
    </bpmn2:extensionElements>
    <bpmn2:property id="Element_pds_record_id" itemSubjectRef="Element_string" name="id"/>
    <bpmn2:property id="Element_pds_document_id" itemSubjectRef="Element_string" name="documentId"/>
    <bpmn2:property id="Element_pds_document_type" itemSubjectRef="Element_string" name="documentType"/>
    <bpmn2:property id="Element_pds_contract_number" itemSubjectRef="Element_string" name="contractNumber"/>
    <bpmn2:property id="Element_pds_contract_date" itemSubjectRef="Element_string" name="contractDate"/>
    <bpmn2:property id="Element_pds_snils" itemSubjectRef="Element_string" name="snils"/>
    <bpmn2:property id="Element_pds_approval_status" itemSubjectRef="Element_string" name="approvalStatus"/>
    <bpmn2:property id="Element_pds_access_token" itemSubjectRef="Element_string" name="accessToken"/>
    <bpmn2:startEvent id="Event_pds_start" name="Создать договор ПДС" sbt:marker.type="Markable" sbt:sbtType="com.sbt.bpms.modeler.plugin.marker.markableStartEvent">
      <bpmn2:outgoing>Flow_pds_start_create</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:task id="Activity_pds_create" name="Зафиксировать договор ПДС" sbt:apiSource="manual" sbt:methodName="POST" sbt:outputMapping="expression" sbt:payloadType="map" sbt:sbtType="com.sbt.bpms.modeler.plugin.marker.GraphQLTask" sbt:url="${env.ds.app}/model/graphql">
      <bpmn2:extensionElements>
        <sbt:httpHeaderList>
          <sbt:httpHeader sbt:id="HTTPHeader_pds_create_content_type" sbt:required="true" xsi:type="sbt:HTTPHeader"><sbt:name>Content-Type</sbt:name><sbt:value>application/json</sbt:value><sbt:type><![CDATA[java.lang.String]]></sbt:type><sbt:source>expression</sbt:source></sbt:httpHeader>
          <sbt:httpHeader sbt:id="HTTPHeader_pds_create_accept" sbt:required="true" xsi:type="sbt:HTTPHeader"><sbt:name>Accept</sbt:name><sbt:value>application/graphql-response+json</sbt:value><sbt:type><![CDATA[java.lang.String]]></sbt:type><sbt:source>expression</sbt:source></sbt:httpHeader>
          <sbt:httpHeader sbt:id="HTTPHeader_pds_create_authorization" sbt:required="true" xsi:type="sbt:HTTPHeader"><sbt:name>Authorization</sbt:name><sbt:value>Bearer ${accessToken}</sbt:value><sbt:type><![CDATA[java.lang.String]]></sbt:type><sbt:source>expression</sbt:source></sbt:httpHeader>
        </sbt:httpHeaderList>
        <sbt:graphQLRequestBody>
          <sbt:query sbt:required="true" sbt:type="literal"><![CDATA[mutation createPdsContract($input: _CreatePdsContractInput!) { packet { createPdsContract(input: $input) { id documentId documentType { id name } contractDate contractNumber snils approvalStatus } } }]]></sbt:query>
          <sbt:operationName>createPdsContract</sbt:operationName>
          <sbt:variables><![CDATA[{ "input": { "documentId": ${documentId}, "documentType": "PDS_CONTRACT", "contractNumber": ${contractNumber}, "contractDate": ${contractDate}, "snils": ${snils}, "approvalStatus": "CREATED" } }]]></sbt:variables>
        </sbt:graphQLRequestBody>
        <sbt:graphQLResponseMapping>
          <sbt:mappingItem sbt:expression="@RESULT.data.packet.createPdsContract.id" sbt:id="Element_pds_map_id" sbt:variableName="id"/>
          <sbt:mappingItem sbt:expression="@RESULT.data.packet.createPdsContract.documentType.name" sbt:id="Element_pds_map_document_type" sbt:variableName="documentType"/>
        </sbt:graphQLResponseMapping>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_pds_start_create</bpmn2:incoming>
      <bpmn2:outgoing>Flow_pds_create_operator_take</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:userTask activiti:candidateGroups="document_operator" activiti:candidateUsers="tester" activiti:dueDate="PT1H" activiti:formKey="localhost" activiti:priority="99" id="Activity_pds_operator_take" name="Взять договор ПДС в работу оператором" sbt:formType="formUrl" sbt:managerRole="app_owner" sbt:marker.type="Markable" sbt:sbtType="com.sbt.bpms.modeler.plugin.marker.markableUserTask">
      <bpmn2:extensionElements>
        <sbt:extraAttributes>
          <sbt:extraAttribute sbt:id="Element_pds_operator_take_extra_document_id" xsi:type="sbt:ExtraAttribute"><sbt:extraAttributeName>documentId</sbt:extraAttributeName><sbt:processVarName>documentId</sbt:processVarName><sbt:type><![CDATA[STRING]]></sbt:type><sbt:code>documentId</sbt:code><sbt:visibility>visible</sbt:visibility><sbt:order>1</sbt:order><sbt:linked>false</sbt:linked></sbt:extraAttribute>
          <sbt:extraAttribute sbt:id="Element_pds_operator_take_extra_contract_number" xsi:type="sbt:ExtraAttribute"><sbt:extraAttributeName>contractNumber</sbt:extraAttributeName><sbt:processVarName>contractNumber</sbt:processVarName><sbt:type><![CDATA[STRING]]></sbt:type><sbt:code>contractNumber</sbt:code><sbt:visibility>visible</sbt:visibility><sbt:order>2</sbt:order><sbt:linked>false</sbt:linked></sbt:extraAttribute>
          <sbt:extraAttribute sbt:id="Element_pds_operator_take_extra_snils" xsi:type="sbt:ExtraAttribute"><sbt:extraAttributeName>snils</sbt:extraAttributeName><sbt:processVarName>snils</sbt:processVarName><sbt:type><![CDATA[STRING]]></sbt:type><sbt:code>snils</sbt:code><sbt:visibility>visible</sbt:visibility><sbt:order>3</sbt:order><sbt:linked>false</sbt:linked></sbt:extraAttribute>
        </sbt:extraAttributes>
        <sbt:taskListenerList><sbt:taskListener sbt:event="complete" sbt:expression="#{execution.setVariable('approvalStatus',approvalStatus)};" sbt:id="Element_pds_operator_take_listener_status" xsi:type="sbt:TaskListener"/><sbt:taskListener sbt:event="complete" sbt:expression="#{execution.setVariable('accessToken',accessToken)};" sbt:id="Element_pds_operator_take_listener_token" xsi:type="sbt:TaskListener"/></sbt:taskListenerList>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_pds_create_operator_take</bpmn2:incoming>
      <bpmn2:incoming>Flow_pds_revision_operator_take</bpmn2:incoming>
      <bpmn2:outgoing>Flow_pds_operator_take_mark_in_work</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask activiti:candidateGroups="document_operator" activiti:candidateUsers="tester" activiti:dueDate="PT1H" activiti:formKey="localhost" activiti:priority="99" id="Activity_pds_operator" name="Обработка договора ПДС оператором" sbt:formType="formUrl" sbt:managerRole="app_owner" sbt:marker.type="Markable" sbt:sbtType="com.sbt.bpms.modeler.plugin.marker.markableUserTask">
      <bpmn2:extensionElements>
        <sbt:extraAttributes>
          <sbt:extraAttribute sbt:id="Element_pds_operator_extra_document_id" xsi:type="sbt:ExtraAttribute"><sbt:extraAttributeName>documentId</sbt:extraAttributeName><sbt:processVarName>documentId</sbt:processVarName><sbt:type><![CDATA[STRING]]></sbt:type><sbt:code>documentId</sbt:code><sbt:visibility>visible</sbt:visibility><sbt:order>1</sbt:order><sbt:linked>false</sbt:linked></sbt:extraAttribute>
          <sbt:extraAttribute sbt:id="Element_pds_operator_extra_contract_number" xsi:type="sbt:ExtraAttribute"><sbt:extraAttributeName>contractNumber</sbt:extraAttributeName><sbt:processVarName>contractNumber</sbt:processVarName><sbt:type><![CDATA[STRING]]></sbt:type><sbt:code>contractNumber</sbt:code><sbt:visibility>visible</sbt:visibility><sbt:order>2</sbt:order><sbt:linked>false</sbt:linked></sbt:extraAttribute>
          <sbt:extraAttribute sbt:id="Element_pds_operator_extra_snils" xsi:type="sbt:ExtraAttribute"><sbt:extraAttributeName>snils</sbt:extraAttributeName><sbt:processVarName>snils</sbt:processVarName><sbt:type><![CDATA[STRING]]></sbt:type><sbt:code>snils</sbt:code><sbt:visibility>visible</sbt:visibility><sbt:order>3</sbt:order><sbt:linked>false</sbt:linked></sbt:extraAttribute>
        </sbt:extraAttributes>
        <sbt:taskListenerList><sbt:taskListener sbt:event="complete" sbt:expression="#{execution.setVariable('approvalStatus',approvalStatus)};" sbt:id="Element_pds_operator_listener_status" xsi:type="sbt:TaskListener"/><sbt:taskListener sbt:event="complete" sbt:expression="#{execution.setVariable('accessToken',accessToken)};" sbt:id="Element_pds_operator_listener_token" xsi:type="sbt:TaskListener"/></sbt:taskListenerList>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_pds_in_work_operator</bpmn2:incoming>
      <bpmn2:outgoing>Flow_pds_operator_gateway</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway default="Flow_pds_operator_reject" id="Gateway_pds_operator_result" name="Решение оператора" sbt:marker.type="Markable" sbt:sbtType="com.sbt.bpms.modeler.plugin.marker.markableExclusiveGateway">
      <bpmn2:incoming>Flow_pds_operator_gateway</bpmn2:incoming>
      <bpmn2:outgoing>Flow_pds_operator_to_approval</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_pds_operator_reject</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask activiti:candidateGroups="approver" activiti:candidateUsers="tester" activiti:dueDate="PT1H" activiti:formKey="localhost" activiti:priority="99" id="Activity_pds_approver_take" name="Взять договор ПДС в работу согласующим" sbt:formType="formUrl" sbt:managerRole="app_owner" sbt:marker.type="Markable" sbt:sbtType="com.sbt.bpms.modeler.plugin.marker.markableUserTask">
      <bpmn2:extensionElements>
        <sbt:extraAttributes>
