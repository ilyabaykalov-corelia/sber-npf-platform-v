    </bpmn2:task>
    <bpmn2:sequenceFlow id="Flow_pds_rejected" name="Отклонено" sourceRef="Gateway_pds_approval_result" targetRef="Activity_pds_mark_rejected">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${execution.getVariable("approvalStatus") == "REJECTED"}</bpmn2:conditionExpression>
