            <sbt:code>snils</sbt:code>
            <sbt:visibility>visible</sbt:visibility>
            <sbt:order>5</sbt:order>
            <sbt:linked>false</sbt:linked>
          </sbt:extraAttribute>
        </sbt:extraAttributes>
        <sbt:taskListenerList>
          <sbt:taskListener sbt:event="complete" sbt:expression="#{execution.setVariable('approvalStatus',approvalStatus)};" sbt:id="Element_pds_task_listener" xsi:type="sbt:TaskListener"/>
          <sbt:taskListener sbt:event="complete" sbt:expression="#{execution.setVariable('accessToken',accessToken)};" sbt:id="Element_pds_task_listener_access_token" xsi:type="sbt:TaskListener"/>
        </sbt:taskListenerList>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_pds_create_approve</bpmn2:incoming>
