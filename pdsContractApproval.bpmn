    </bpmn2:exclusiveGateway>
    <bpmn2:task id="Activity_pds_mark_in_work" name="Отметить договор ПДС взятым в работу" sbt:apiSource="manual" sbt:methodName="POST" sbt:outputMapping="expression" sbt:payloadType="map" sbt:sbtType="com.sbt.bpms.modeler.plugin.marker.GraphQLTask" sbt:url="${env.ds.app}/model/graphql"><bpmn2:extensionElements><sbt:httpHeaderList><sbt:httpHeader sbt:id="HTTPHeader_pds_in_work_content_type" sbt:required="true" xsi:type="sbt:HTTPHeader"><sbt:name>Content-Type</sbt:name><sbt:value>application/json</sbt:value><sbt:type><![CDATA[java.lang.String]]></sbt:type><sbt:source>expression</sbt:source></sbt:httpHeader><sbt:httpHeader sbt:id="HTTPHeader_pds_in_work_accept" sbt:required="true" xsi:type="sbt:HTTPHeader"><sbt:name>Accept</sbt:name><sbt:value>application/graphql-response+json</sbt:value><sbt:type><![CDATA[java.lang.String]]></sbt:type><sbt:source>expression</sbt:source></sbt:httpHeader><sbt:httpHeader sbt:id="HTTPHeader_pds_in_work_authorization" sbt:required="true" xsi:type="sbt:HTTPHeader"><sbt:name>Authorization</sbt:name><sbt:value>Bearer ${accessToken}</sbt:value><sbt:type><![CDATA[java.lang.String]]></sbt:type><sbt:source>expression</sbt:source></sbt:httpHeader></sbt:httpHeaderList><sbt:graphQLRequestBody><sbt:query sbt:required="true" sbt:type="literal"><![CDATA[mutation updatePdsContract($input: _UpdatePdsContractInput!) { packet { updatePdsContract(input: $input) { id approvalStatus } } }]]></sbt:query><sbt:operationName>updatePdsContract</sbt:operationName><sbt:variables><![CDATA[{ "input": { "id": ${id}, "approvalStatus": "IN_WORK" } }]]></sbt:variables></sbt:graphQLRequestBody></bpmn2:extensionElements><bpmn2:incoming>Flow_pds_operator_take_mark_in_work</bpmn2:incoming><bpmn2:outgoing>Flow_pds_in_work_operator</bpmn2:outgoing></bpmn2:task>
