    </bpmn2:userTask>
    <bpmn2:sequenceFlow id="Flow_pds_approve_gateway" name="" sourceRef="Activity_pds_approve" targetRef="Gateway_pds_approval_result"/>
    <bpmn2:exclusiveGateway default="Flow_pds_approved" id="Gateway_pds_approval_result" name="" sbt:marker.type="Markable" sbt:sbtType="com.sbt.bpms.modeler.plugin.marker.markableExclusiveGateway">
      <bpmn2:incoming>Flow_pds_approve_gateway</bpmn2:incoming>
