    <bpmn2:exclusiveGateway default="Flow_pds_approver_reject" id="Gateway_pds_approver_result" name="Решение согласующего" sbt:marker.type="Markable" sbt:sbtType="com.sbt.bpms.modeler.plugin.marker.markableExclusiveGateway">
