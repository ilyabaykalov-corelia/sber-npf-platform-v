          <sbt:extraAttribute sbt:id="Element_pds_approver_take_extra_contract_number" xsi:type="sbt:ExtraAttribute"><sbt:extraAttributeName>contractNumber</sbt:extraAttributeName><sbt:processVarName>contractNumber</sbt:processVarName><sbt:type><![CDATA[STRING]]></sbt:type><sbt:code>contractNumber</sbt:code><sbt:visibility>visible</sbt:visibility><sbt:order>2</sbt:order><sbt:linked>false</sbt:linked></sbt:extraAttribute>
          <sbt:extraAttribute sbt:id="Element_pds_approver_take_extra_snils" xsi:type="sbt:ExtraAttribute"><sbt:extraAttributeName>snils</sbt:extraAttributeName><sbt:processVarName>snils</sbt:processVarName><sbt:type><![CDATA[STRING]]></sbt:type><sbt:code>snils</sbt:code><sbt:visibility>visible</sbt:visibility><sbt:order>3</sbt:order><sbt:linked>false</sbt:linked></sbt:extraAttribute>
        </sbt:extraAttributes>
        <sbt:taskListenerList><sbt:taskListener sbt:event="complete" sbt:expression="#{execution.setVariable('approvalStatus',approvalStatus)};" sbt:id="Element_pds_approver_take_listener_status" xsi:type="sbt:TaskListener"/><sbt:taskListener sbt:event="complete" sbt:expression="#{execution.setVariable('accessToken',accessToken)};" sbt:id="Element_pds_approver_take_listener_token" xsi:type="sbt:TaskListener"/></sbt:taskListenerList>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_pds_on_approval_approver_take</bpmn2:incoming>
      <bpmn2:outgoing>Flow_pds_approver_take_approver</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask activiti:candidateGroups="approver" activiti:candidateUsers="tester" activiti:dueDate="PT1H" activiti:formKey="localhost" activiti:priority="99" id="Activity_pds_approver" name="Согласование договора ПДС" sbt:formType="formUrl" sbt:managerRole="app_owner" sbt:marker.type="Markable" sbt:sbtType="com.sbt.bpms.modeler.plugin.marker.markableUserTask">
      <bpmn2:extensionElements>
        <sbt:extraAttributes>
          <sbt:extraAttribute sbt:id="Element_pds_approver_extra_document_id" xsi:type="sbt:ExtraAttribute"><sbt:extraAttributeName>documentId</sbt:extraAttributeName><sbt:processVarName>documentId</sbt:processVarName><sbt:type><![CDATA[STRING]]></sbt:type><sbt:code>documentId</sbt:code><sbt:visibility>visible</sbt:visibility><sbt:order>1</sbt:order><sbt:linked>false</sbt:linked></sbt:extraAttribute>
